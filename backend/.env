# Environment
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/iasw
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/iasw

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude) - Using HAI proxy
ANTHROPIC_API_KEY=5a62aeff-ce65-43a4-979c-fbe0174ca30a
ANTHROPIC_BASE_URL=http://localhost:6655/anthropic

# LLM Settings
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# OCR Settings
TESSERACT_CMD=/opt/homebrew/bin/tesseract
OCR_CONFIDENCE_THRESHOLD=0.6
GOOGLE_VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# Forgery Detection Thresholds
FORGERY_PASS_THRESHOLD=0.85
FORGERY_FAIL_THRESHOLD=0.60

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# LangSmith (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=iasw

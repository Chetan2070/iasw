{
  "info": {
    "name": "IASW API Collection",
    "description": "Intelligent Account Servicing Workflow - API endpoints for authentication, requests, checker workbench, customers, admin, and health checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Authenticate user and return JWT tokens.\n\nTest Credentials:\n- admin / admin123 (admin role)\n- staff / staff123 (staff role)\n- chk-001 / checker123 (checker role)",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Refresh access token using refresh token.",
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Register a new user account (self-service).\n\nRoles available: staff, checker\n\nAdmin accounts cannot be self-registered.",
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]

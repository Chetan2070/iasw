    {
      "name": "Requests",
      "item": [
        {
          "name": "Create Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Create a new change request.\n\nChange Types: LEGAL_NAME, ADDRESS, CONTACT, KYC\n\nDocument Types: GAZETTE_NOTIFICATION, PASSPORT, DRIVERS_LICENSE, UTILITY_BILL, BANK_STATEMENT",
            "url": {
              "raw": "{{base_url}}/requests",
              "host": ["{{base_url}}"],
              "path": ["requests"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_number\": \"1234567890\",\n  \"change_type\": \"LEGAL_NAME\",\n  \"document_type\": \"GAZETTE_NOTIFICATION\",\n  \"current_value\": \"John Doe\",\n  \"new_value\": \"John Smith\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Upload a supporting document for a request.\n\nSupported File Types: PDF, JPEG, PNG, TIFF\nMax File Size: 10 MB",
            "url": {
              "raw": "{{base_url}}/requests/REQ-XXXXXXXX/upload",
              "host": ["{{base_url}}"],
              "path": ["requests", "REQ-XXXXXXXX", "upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/document.pdf"
                }
              ]
            }
          }
        },
        {
          "name": "List Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "List requests with optional filters.\n\nFilters: customer_id, change_type, status\nPagination: page (default: 1), limit (default: 20, max: 100)",
            "url": {
              "raw": "{{base_url}}/requests?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["requests"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "customer_id",
                  "value": "CUST001",
                  "disabled": true
                },
                {
                  "key": "change_type",
                  "value": "LEGAL_NAME",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "AI_VERIFIED_PENDING_HUMAN",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Request Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Get summary statistics for all requests.\n\nReturns: total, pending, approved, rejected",
            "url": {
              "raw": "{{base_url}}/requests/stats/summary",
              "host": ["{{base_url}}"],
              "path": ["requests", "stats", "summary"]
            }
          }
        },
        {
          "name": "Get Request Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Get full details of a request including extracted values, confidence scores, forgery detection results, AI recommendation and summary.",
            "url": {
              "raw": "{{base_url}}/requests/REQ-XXXXXXXX",
              "host": ["{{base_url}}"],
              "path": ["requests", "REQ-XXXXXXXX"]
            }
          }
        },
        {
          "name": "Delete Request",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Delete a request. For development/testing purposes.",
            "url": {
              "raw": "{{base_url}}/requests/REQ-XXXXXXXX",
              "host": ["{{base_url}}"],
              "path": ["requests", "REQ-XXXXXXXX"]
            }
          }
        }
      ]

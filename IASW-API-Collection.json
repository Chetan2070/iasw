            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }

    {
      "name": "Checker",
      "item": [
        {
          "name": "Get Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Get the queue of requests pending human review.\n\nFilters: risk_tier (LOW, MEDIUM, HIGH), ai_recommendation (APPROVE, REJECT, MANUAL_REVIEW)",
            "url": {
              "raw": "{{base_url}}/checker/queue?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["checker", "queue"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "risk_tier",
                  "value": "HIGH",
                  "disabled": true
                },
                {
                  "key": "ai_recommendation",
                  "value": "APPROVE",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Claim Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Claim a request for review. Checker has 15 minutes to complete review.",
            "url": {
              "raw": "{{base_url}}/checker/claim/REQ-XXXXXXXX?checker_id=chk-001",
              "host": ["{{base_url}}"],
              "path": ["checker", "claim", "REQ-XXXXXXXX"],
              "query": [
                {
                  "key": "checker_id",
                  "value": "chk-001"
                }
              ]
            }
          }
        },
        {
          "name": "Get Review Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Get complete review data for the checker UI including request details, extracted values, confidence scores, forgery detection, AI recommendation.",
            "url": {
              "raw": "{{base_url}}/checker/review/REQ-XXXXXXXX",
              "host": ["{{base_url}}"],
              "path": ["checker", "review", "REQ-XXXXXXXX"]
            }
          }
        },
        {
          "name": "Submit Decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Submit a decision for a claimed request.\n\nDecisions:\n- APPROVE: Triggers RPS update\n- REJECT: Requires reason\n- MORE_INFO: Requires reason\n- ESCALATE: Requires reason",
            "url": {
              "raw": "{{base_url}}/checker/decide/REQ-XXXXXXXX?checker_id=chk-001",
              "host": ["{{base_url}}"],
              "path": ["checker", "decide", "REQ-XXXXXXXX"],
              "query": [
                {
                  "key": "checker_id",
                  "value": "chk-001"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"reason\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Release Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Release a claimed request back to the queue.",
            "url": {
              "raw": "{{base_url}}/checker/release/REQ-XXXXXXXX?checker_id=chk-001",
              "host": ["{{base_url}}"],
              "path": ["checker", "release", "REQ-XXXXXXXX"],
              "query": [
                {
                  "key": "checker_id",
                  "value": "chk-001"
                }
              ]
            }
          }
        },
        {
          "name": "Get Review History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "default"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "description": "Get completed reviews for a specific checker.",
            "url": {
              "raw": "{{base_url}}/checker/reviews?checker_id=chk-001&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["checker", "reviews"],
              "query": [
                {
                  "key": "checker_id",
                  "value": "chk-001"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
